{
  "name": "4d",
  "version": "1.3.3",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && bun run lint:canonical",
    "lint:fix": "biome lint --write --unsafe . && bun run lint:canonical:fix",
    "lint:canonical": "bun scripts/lint-canonical-tailwind-classes.ts",
    "lint:canonical:fix": "bun run lint:canonical -- --fix",
    "check": "biome check .",
    "check:fix": "biome check --write --unsafe . && bun run lint:canonical:fix",
    "typecheck": "bun --filter '*' typecheck",
    "build": "bun --filter '*' build",
    "test": "bun --filter '!@4d/e2e' test",
    "test:unit": "bun --filter '!@4d/e2e' test",
    "test:coverage": "bun --filter '!@4d/e2e' test:coverage",
    "coverage:report": "bun run test:coverage && cp apps/dataexplorer/coverage/lcov.info apps/dataexplorer/coverage/lcov-main.info && cd apps/dataexplorer && bun test --preload ./src/test-setup.ts src/lib/api.test.ts --coverage --coverage-reporter=lcov && cd ../.. && bun scripts/merge-dataexplorer-coverage.ts && bun scripts/coverage-report.ts",
    "coverage:html": "bun scripts/merge-all-lcov.ts && bun scripts/generate-coverage-html.ts",
    "docs:coverage": "bun scripts/generate-coverage-html.ts --docs",
    "docs:dev": "bun --filter @4d/docs dev",
    "docs:build": "bun --filter @4d/docs build",
    "stats:download": "bun scripts/update-download-stats.ts",
    "quick-ci": "bun run format:check && bun run lint && bun run check && bun run typecheck && bun run test",
    "quick-ci:fix": "bun run check:fix && bun run quick-ci",
    "test:e2e": "bun --filter @4d/e2e test",
    "test:e2e:ui": "bun --filter @4d/e2e test:ui",
    "test:e2e:headed": "bun --filter @4d/e2e test:headed",
    "test:e2e:debug": "bun --filter @4d/e2e test:debug",
    "test:e2e:report": "bun --filter @4d/e2e test:report",
    "test:e2e:codegen": "bun --filter @4d/e2e test:codegen",
    "test:e2e:docker": "docker build -f Dockerfile.e2e -t dataexplorer-e2e . && docker run --rm dataexplorer-e2e",
    "capture:screenshots": "bun --filter @4d/e2e capture:screenshots && bun run screenshots:compare -- -d",
    "screenshots:compare": "bun scripts/compare-screenshot-changes.ts",
    "release": "bun scripts/release.ts",
    "release:patch": "bun scripts/release.ts patch",
    "release:minor": "bun scripts/release.ts minor",
    "release:major": "bun scripts/release.ts major"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/dotenv": "8.2.3",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "bun-types": "1.3.14",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0"
  },
  "dependencies": {
    "@types/canvas-confetti": "1.9.0",
    "canvas-confetti": "1.9.4",
    "dotenv": "17.4.2"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "patchedDependencies": {
    "@monaco-editor/react@4.7.0": "patches/@monaco-editor%2Freact@4.7.0.patch"
  }
}
