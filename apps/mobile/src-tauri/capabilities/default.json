{
  "identifier": "default",
  "description": "Default capability for Data Explorer mobile app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "opener:default",
    "allow-list-http-jar-cookies",
    "allow-desktop-http-request",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        }
      ]
    }
  ]
}
