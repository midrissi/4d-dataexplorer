<?xml version="1.0" encoding="utf-8"?>
<!--
  Apply after `tauri android init` generates apps/mobile/src-tauri/gen/android
  (or src-tauri/android). Copy to app/src/main/res/xml/network_security_config.xml
  and reference from AndroidManifest.xml:

    <application
      android:networkSecurityConfig="@xml/network_security_config"
      android:usesCleartextTraffic="true"
      ...>

  Allows cleartext HTTP to LAN/lab REST servers (same use case as desktop).
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </base-config>
</network-security-config>
