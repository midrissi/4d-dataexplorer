{
  "name": "@4d/mobile",
  "private": true,
  "version": "1.3.4",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3005",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "tauri:dev": "tauri dev",
    "tauri:android:dev": "bash ./scripts/android-dev.sh",
    "tauri:android:build": "bash ./scripts/android-build.sh",
    "tauri:android:dev:raw": "tauri android dev",
    "tauri:android:build:raw": "tauri android build",
    "patch:splash": "bash ./scripts/patch-mobile-splash.sh",
    "tauri:ios:dev": "bash ./scripts/ios-dev.sh",
    "tauri:ios:dev:raw": "tauri ios dev",
    "tauri:ios:build": "bash ./scripts/ios-build.sh",
    "tauri:ios:build:device": "bash ./scripts/ios-build.sh --target aarch64 --ci",
    "tauri:ios:build:sim": "bash ./scripts/ios-build.sh --target aarch64-sim --ci",
    "signing:android": "bash ./scripts/generate-mobile-signing.sh android",
    "signing:android:sideload": "bash ./scripts/generate-mobile-signing.sh android --sideload",
    "signing:ios:checklist": "bash ./scripts/generate-mobile-signing.sh ios checklist",
    "signing:ios:encode": "bash ./scripts/generate-mobile-signing.sh ios encode",
    "signing:secrets": "bash ./scripts/generate-mobile-signing.sh secrets-list"
  },
  "dependencies": {
    "@4d/dataexplorer": "workspace:*",
    "@4d/rest": "workspace:*",
    "@4d/ui": "workspace:*",
    "@4djs/ai-widgets": "0.1.1",
    "@4djs/assistant": "0.2.1",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@tauri-apps/plugin-http": "^2.4.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-store": "^2.2.0",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "10.5.2",
    "postcss": "8.5.19",
    "tailwindcss": "4.3.2",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  }
}
