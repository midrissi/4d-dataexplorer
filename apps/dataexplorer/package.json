{
  "name": "@4d/dataexplorer",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3002",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome lint ./src",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./src/test-setup.ts",
    "test:api": "bun test --preload ./src/test-setup.ts src/lib/api.test.ts",
    "test:coverage": "bun test --preload ./src/test-setup.ts --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "check-i18n": "bun scripts/check-i18n-keys.ts"
  },
  "dependencies": {
    "@4d/base64-decoder": "workspace:*",
    "@4d/json-schema-builder": "workspace:*",
    "@4d/orda-language-service": "workspace:*",
    "@4d/rest": "workspace:*",
    "@4d/ui": "workspace:*",
    "@4djs/ai-widgets": "0.1.1",
    "@4djs/assistant": "0.2.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/react-virtual": "^3.14.7",
    "@xyflow/react": "12.11.2",
    "ace-builds": "1.44.0",
    "ag-grid-community": "36.0.0",
    "ag-grid-react": "36.0.0",
    "elkjs": "0.11.1",
    "lucide-react": "1.24.0",
    "parse-duration": "2.1.8",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.7",
    "react-ace": "14.0.1",
    "react-dom": "19.2.7",
    "recharts": "3.9.2",
    "rxjs": "7.8.2",
    "tailwindcss-animate": "1.0.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "10.5.2",
    "happy-dom": "20.10.6",
    "postcss": "8.5.19",
