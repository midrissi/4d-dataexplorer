{
  "identifier": "default",
  "description": "Default capability for Data Explorer desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "store:default",
    "window-state:default",
    "updater:default",
    "process:default",
    "dialog:default",
    "opener:default",
    "allow-list-http-jar-cookies",
    "allow-desktop-http-request",
    "allow-check-desktop-update-for-tag",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" }
      ]
    },
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        }
      ]
    }
  ]
}
